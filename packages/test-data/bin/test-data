#!/bin/sh
set -eu
PACKAGE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ ! -x "$PACKAGE_DIR/.venv/bin/massa" ]; then
  echo "Runtime ausente. Execute: sh $PACKAGE_DIR/scripts/install.sh" >&2
  exit 1
fi
if [ "${1:-}" = help ]; then shift; set -- --help "$@"; fi
exec "$PACKAGE_DIR/.venv/bin/massa" "$@"
