#!/bin/bash
# pkg-scheduler
# Schedule commands and scripts from the AICockpit CLI.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Configuration constants
DEFAULT_RUN_TIME="09:00"
DEFAULT_REPEAT_INTERVAL_MINUTES=1
SCHEDULER_DIR="${COCKPIT_SCHEDULER_DIR:-${HOME}/.cockpit/workspace/scheduler}"
CONFIG_FILE="${SCHEDULER_DIR}/config"
JOBS_FILE="${SCHEDULER_DIR}/jobs.json"

# Load optional user configuration
load_config() {
    if [[ -f "${CONFIG_FILE}" ]]; then
        while IFS='=' read -r key value; do
            [[ -z "${key}" || "${key}" =~ ^# ]] && continue
            value="${value%%#*}"
            value="${value%"${value##*[![:space:]]}"}"
            case "${key}" in
                workspace_dir)
                    SCHEDULER_DIR="${value}"
                    JOBS_FILE="${SCHEDULER_DIR}/jobs.json"
                    ;;
                default_time) DEFAULT_RUN_TIME="${value}" ;;
            esac
        done < "${CONFIG_FILE}"
    fi
}
load_config

ensure_dir() {
    mkdir -p "${SCHEDULER_DIR}"
}

require_json_tool() {
    if command -v python3 >/dev/null 2>&1; then
        echo "python3"
        return 0
    fi
    if command -v python >/dev/null 2>&1; then
        echo "python"
        return 0
    fi
    if command -v jq >/dev/null 2>&1; then
        echo "jq"
        return 0
    fi
    echo "Error: python3 or jq is required to manage scheduler jobs." >&2
    return 1
}

JSON_TOOL=""

# Date helpers
now_iso() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

now_epoch() {
    date +%s
}

iso_to_epoch() {
    local iso="${1}"
    local epoch
    epoch=$(date -d "${iso}" +%s 2>/dev/null)
    if [[ -n "${epoch}" ]]; then
        echo "${epoch}"
        return 0
    fi
    epoch=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "${iso}" +%s 2>/dev/null)
    if [[ -n "${epoch}" ]]; then
        echo "${epoch}"
        return 0
    fi
    echo "0"
}

epoch_to_iso() {
    local epoch="${1}"
    local iso
    iso=$(date -u -d "@${epoch}" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null)
    if [[ -n "${iso}" ]]; then
        echo "${iso}"
        return 0
    fi
    iso=$(date -u -r "${epoch}" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null)
    if [[ -n "${iso}" ]]; then
        echo "${iso}"
        return 0
    fi
    echo ""
}

parse_time() {
    local time_str="${1:-${DEFAULT_RUN_TIME}}"
    local hour="${time_str%%:*}"
    local minute="${time_str##*:}"
    hour="${hour#0}"
    minute="${minute#0}"
    echo "${hour} ${minute}"
}

today_at_time_epoch() {
    local hour="${1}"
    local minute="${2}"
    local epoch
    epoch=$(date -d "today ${hour}:${minute}:00" +%s 2>/dev/null)
    if [[ -n "${epoch}" ]]; then
        echo "${epoch}"
        return 0
    fi
    local now
    now=$(now_epoch)
    epoch=$(date -r "${now}" -v"${hour}"H -v"${minute}"M -v0S +%s 2>/dev/null)
    echo "${epoch}"
}

next_daily_run() {
    local hour minute
    read -r hour minute <<< "$(parse_time "${1:-${DEFAULT_RUN_TIME}}")"
    local target
    target=$(today_at_time_epoch "${hour}" "${minute}")
    local now
    now=$(now_epoch)
    if (( target <= now )); then
        target=$((target + 86400))
    fi
    epoch_to_iso "${target}"
}

next_weekend_run() {
    local hour minute
    read -r hour minute <<< "$(parse_time "${1:-${DEFAULT_RUN_TIME}}")"
    local now dow
    now=$(now_epoch)
    dow=$(date -u +%u)  # 1=Mon ... 7=Sun
    local days_until_sat=0
    if (( dow < 6 )); then
        days_until_sat=$((6 - dow))
    elif (( dow == 7 )); then
        days_until_sat=6
    fi
    local target
    target=$(today_at_time_epoch "${hour}" "${minute}")
    target=$((target + days_until_sat * 86400))
    if (( target <= now )); then
        target=$((target + 7 * 86400))
    fi
    epoch_to_iso "${target}"
}

next_repeat_run() {
    local last_run_epoch="${1:-0}"
    local interval_minutes="${2:-${DEFAULT_REPEAT_INTERVAL_MINUTES}}"
    local now base target
    now=$(now_epoch)
    base=$((last_run_epoch > 0 ? last_run_epoch : now))
    target=$((base + interval_minutes * 60))
    epoch_to_iso "${target}"
}

# Cron field matching
cron_field_match() {
    local value="${1}"
    local field="${2}"

    [[ "${field}" == "*" ]] && return 0

    if [[ "${field}" =~ ^([0-9]+)-([0-9]+)(/([0-9]+))?$ ]]; then
        local start="${BASH_REMATCH[1]}"
        local end="${BASH_REMATCH[2]}"
        local step="${BASH_REMATCH[4]:-1}"
        for ((i = start; i <= end; i += step)); do
            (( i == value )) && return 0
        done
        return 1
    fi

    if [[ "${field}" =~ ^\*/([0-9]+)$ ]]; then
        local step="${BASH_REMATCH[1]}"
        (( value % step == 0 )) && return 0
        return 1
    fi

    local items
    IFS=',' read -r -a items <<< "${field}"
    for item in "${items[@]}"; do
        item="${item// /}"
        [[ "${item}" == "${value}" ]] && return 0
    done
    return 1
}

cron_match_now() {
    local expr="${1}"
    local fields
    IFS=' ' read -r -a fields <<< "${expr}"
    if [[ "${#fields[@]}" -ne 5 ]]; then
        echo "Error: invalid cron expression '${expr}' (expected 5 fields)" >&2
        return 1
    fi

    local minute hour dom month dow
    read -r minute hour dom month dow <<< "$(date -u +"%M %H %d %m %u")"
    minute="${minute#0}"
    hour="${hour#0}"
    dom="${dom#0}"
    month="${month#0}"
    dow=$((dow % 7))  # cron weekday: 0=Sun, 1=Mon ... 6=Sat

    cron_field_match "${minute}" "${fields[0]}" || return 1
    cron_field_match "${hour}" "${fields[1]}" || return 1
    cron_field_match "${dom}" "${fields[2]}" || return 1
    cron_field_match "${month}" "${fields[3]}" || return 1
    cron_field_match "${dow}" "${fields[4]}" || return 1
    return 0
}

describe_schedule() {
    local cron="${1}"
    case "${cron}" in
        "0 9 * * *") echo "daily at 09:00" ;;
        "0 9 * * 0,6") echo "weekends at 09:00" ;;
        "0 9 * * 1-5") echo "weekdays at 09:00" ;;
        *) echo "cron ${cron}" ;;
    esac
}

generate_id() {
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen | tr '[:upper:]' '[:lower:]' | tr -d '-'
        return 0
    fi
    if [[ -r /proc/sys/kernel/random/uuid ]]; then
        tr -d '-' < /proc/sys/kernel/random/uuid
        return 0
    fi
    printf "%s%04d" "$(date +%s)" "$((RANDOM % 10000))"
}

# JSON helpers via embedded Python (or jq fallback)
json_operation() {
    if [[ -z "${JSON_TOOL}" ]]; then
        JSON_TOOL=$(require_json_tool) || exit 1
    fi
    case "${JSON_TOOL}" in
        python3|python)
            "${JSON_TOOL}" - "$@" <<'PY'
import json, sys, os

JOBS_PATH = sys.argv[1]
CMD = sys.argv[2]

def load_jobs():
    if not os.path.exists(JOBS_PATH):
        return []
    try:
        with open(JOBS_PATH) as f:
            return json.load(f)
    except Exception as e:
        print(f"Error reading jobs file: {e}", file=sys.stderr)
        sys.exit(1)

def save_jobs(jobs):
    os.makedirs(os.path.dirname(JOBS_PATH), exist_ok=True)
    with open(JOBS_PATH, "w") as f:
        json.dump(jobs, f, indent=2)

if CMD == "read":
    print(json.dumps(load_jobs()))

elif CMD == "write":
    jobs = json.loads(sys.argv[3])
    save_jobs(jobs)

elif CMD == "add":
    new_job = json.loads(sys.argv[3])
    jobs = load_jobs()
    jobs.append(new_job)
    save_jobs(jobs)
    print(new_job["id"])

elif CMD == "list":
    for j in load_jobs():
        print(
            f"{j['id']}\t{j.get('name', '')}\t{j['command']}\t"
            f"{j.get('cron') or ''}\t{j.get('next_run') or ''}\t"
            f"{j.get('run_count', 0)}\t{j.get('max_runs') or ''}"
        )

elif CMD == "remove":
    target_id = sys.argv[3]
    jobs = load_jobs()
    before = len(jobs)
    jobs = [j for j in jobs if j["id"] != target_id]
    if len(jobs) == before:
        print(f"Error: job {target_id} not found", file=sys.stderr)
        sys.exit(1)
    save_jobs(jobs)

elif CMD == "update":
    target_id = sys.argv[3]
    updates = json.loads(sys.argv[4])
    jobs = load_jobs()
    found = False
    for j in jobs:
        if j["id"] == target_id:
            j.update(updates)
            found = True
            break
    if not found:
        print(f"Error: job {target_id} not found", file=sys.stderr)
        sys.exit(1)
    save_jobs(jobs)

elif CMD == "status":
    jobs = load_jobs()
    total = len(jobs)
    cron_jobs = sum(1 for j in jobs if j.get("cron"))
    repeat_jobs = sum(1 for j in jobs if not j.get("cron"))
    print(f"total\t{total}")
    print(f"cron\t{cron_jobs}")
    print(f"repeat\t{repeat_jobs}")
PY
            ;;
        jq)
            case "${1}" in
                read) jq '.' "${JOBS_FILE}" 2>/dev/null || echo '[]' ;;
                write) echo "${2}" | jq . > "${JOBS_FILE}" ;;
                *) echo "Error: unsupported json operation with jq: ${1}" >&2; return 1 ;;
            esac
            ;;
    esac
}

read_jobs() {
    if [[ ! -f "${JOBS_FILE}" ]]; then
        echo "[]"
        return 0
    fi
    json_operation "${JOBS_FILE}" read
}

write_jobs() {
    ensure_dir
    json_operation "${JOBS_FILE}" write "${1}"
}

add_job_to_store() {
    json_operation "${JOBS_FILE}" add "${1}"
}

remove_job_from_store() {
    json_operation "${JOBS_FILE}" remove "${1}"
}

update_job_in_store() {
    json_operation "${JOBS_FILE}" update "${1}" "${2}"
}

usage() {
    cat <<'USAGE'
Usage: cockpit scheduler <subcommand> [flags]

Subcommands:
  add <command> [flags]      Schedule a command
  list                       List scheduled jobs
  remove <id>                Remove a job
  run                        Execute pending jobs
  install                    Install systemd/launchd timer
  status                     Show scheduler statistics

Add flags:
  --cron "EXPR"              Cron expression (5 fields)
  --daily                    Run every day at 09:00 UTC
  --weekends                 Run every Saturday and Sunday at 09:00 UTC
  --repeat N                 Run N times (default interval 1 minute)
  --name "TAG"               Optional job name/tag

Examples:
  cockpit scheduler add "cockpit deploy" --cron "0 9 * * 1-5"
  cockpit scheduler add "echo hello" --repeat 3
  cockpit scheduler add "scripts/backup.sh" --daily
  cockpit scheduler add "scripts/weekend-report.sh" --weekends
  cockpit scheduler list
  cockpit scheduler remove abc123
  cockpit scheduler run
  cockpit scheduler install
  cockpit scheduler status
USAGE
}

json_escape() {
    "${JSON_TOOL}" - "$1" <<'PY'
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

cmd_add() {
    local command=""
    local cron=""
    local max_runs=""
    local name=""

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --cron)
                cron="${2:-}"
                shift 2
                ;;
            --daily)
                cron="0 9 * * *"
                shift
                ;;
            --weekends)
                cron="0 9 * * 0,6"
                shift
                ;;
            --repeat)
                max_runs="${2:-}"
                shift 2
                ;;
            --name)
                name="${2:-}"
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                if [[ -z "${command}" ]]; then
                    command="${1}"
                else
                    command="${command} ${1}"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "${command}" ]]; then
        echo "Error: command is required" >&2
        usage >&2
        exit 1
    fi

    if [[ -z "${cron}" && -z "${max_runs}" ]]; then
        echo "Error: provide --cron, --daily, --weekends or --repeat" >&2
        exit 1
    fi

    if [[ -n "${max_runs}" && ! "${max_runs}" =~ ^[0-9]+$ ]]; then
        echo "Error: --repeat must be a positive integer" >&2
        exit 1
    fi

    local next_run="null"
    if [[ -n "${cron}" ]]; then
        case "${cron}" in
            "0 9 * * *") next_run="$(next_daily_run)" ;;
            "0 9 * * 0,6") next_run="$(next_weekend_run)" ;;
            *)
                # For arbitrary cron, run at the next matching minute when scheduler is invoked.
                next_run="null"
                ;;
        esac
    else
        next_run="$(now_iso)"
    fi

    local max_runs_json="null"
    [[ -n "${max_runs}" ]] && max_runs_json="${max_runs}"

    local id
    id=$(generate_id)
    local created_at
    created_at=$(now_iso)

    local cron_json="null"
    [[ -n "${cron}" ]] && cron_json=$(json_escape "${cron}")
    local next_run_json="null"
    [[ -n "${next_run}" && "${next_run}" != "null" ]] && next_run_json=$(json_escape "${next_run}")
    local name_json=""
    [[ -n "${name}" ]] && name_json=$(json_escape "${name}") || name_json="\"\""
    local command_json=""
    command_json=$(json_escape "${command}")

    local new_job
    new_job=$(printf '{"id":%s,"name":%s,"command":%s,"cron":%s,"next_run":%s,"last_run":null,"run_count":0,"max_runs":%s,"created_at":%s}' \
        "$(json_escape "${id}")" "${name_json}" "${command_json}" "${cron_json}" "${next_run_json}" "${max_runs_json}" "$(json_escape "${created_at}")")

    ensure_dir
    add_job_to_store "${new_job}"

    echo "[+] Scheduled job"
    echo "    ID:      ${id}"
    echo "    Name:    ${name:-<none>}"
    echo "    Command: ${command}"
    if [[ -n "${cron}" ]]; then
        echo "    Schedule: $(describe_schedule "${cron}")"
    fi
    if [[ -n "${max_runs}" ]]; then
        echo "    Max runs: ${max_runs}"
    fi
}

cmd_list() {
    local jobs
    jobs=$(read_jobs)
    local count
    count=$(echo "${jobs}" | "${JSON_TOOL}" -c "import json,sys; print(len(json.load(sys.stdin)))")
    if [[ "${count}" == "0" ]]; then
        echo "No scheduled jobs."
        return 0
    fi

    printf "%-12s %-12s %-30s %-20s %-20s %-6s %-8s\n" \
        "ID" "NAME" "COMMAND" "SCHEDULE" "NEXT RUN" "COUNT" "MAX"
    printf "%.0s-" {1..120}
    printf "\n"

    json_operation "${JOBS_FILE}" list | while IFS=$'\t' read -r id name command cron next_run count max_runs; do
        local schedule_desc="${cron}"
        [[ -n "${cron}" ]] && schedule_desc="$(describe_schedule "${cron}")"
        [[ -z "${cron}" ]] && schedule_desc="repeat ${max_runs:-∞}"
        printf "%-12s %-12s %-30s %-20s %-20s %-6s %-8s\n" \
            "${id:0:12}" "${name:0:12}" "${command:0:30}" "${schedule_desc:0:20}" "${next_run:0:20}" "${count}" "${max_runs:-∞}"
    done
}

cmd_remove() {
    local id="${1:-}"
    if [[ -z "${id}" ]]; then
        echo "Error: job ID is required" >&2
        exit 1
    fi
    remove_job_from_store "${id}"
    echo "Job ${id} removed."
}

execute_command() {
    local command="${1}"
    bash -c "${command}"
}

cmd_run() {
    local jobs
    jobs=$(read_jobs)
    local count
    count=$(echo "${jobs}" | "${JSON_TOOL}" -c "import json,sys; print(len(json.load(sys.stdin)))")
    if [[ "${count}" == "0" ]]; then
        echo "[scheduler] no jobs scheduled"
        return 0
    fi

    local now
    now=$(now_epoch)
    local ran=0
    local ids_to_remove=()

    for ((i = 0; i < count; i++)); do
        local job
        job=$(echo "${jobs}" | "${JSON_TOOL}" -c "import json,sys; print(json.dumps(json.load(sys.stdin)[int(sys.argv[1])]))" "${i}")

        local id command cron next_run run_count max_runs
        id=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin)['id'])")
        command=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin)['command'])")
        cron=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('cron') or '')")
        next_run=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('next_run') or '')")
        run_count=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('run_count', 0))")
        max_runs=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('max_runs') or '')")

        local should_run=false
        local next_run_epoch=0

        if [[ -n "${cron}" ]]; then
            if cron_match_now "${cron}"; then
                should_run=true
            fi
        fi

        if [[ "${should_run}" == false && -n "${next_run}" ]]; then
            next_run_epoch=$(iso_to_epoch "${next_run}")
            if (( next_run_epoch > 0 && next_run_epoch <= now )); then
                should_run=true
            fi
        fi

        [[ "${should_run}" == false ]] && continue

        echo "[scheduler] running job ${id}: ${command}"
        execute_command "${command}"
        local exit_code=$?
        if (( exit_code == 0 )); then
            echo "[scheduler] job ${id} completed successfully"
        else
            echo "[scheduler] job ${id} failed with exit code ${exit_code}"
        fi

        run_count=$((run_count + 1))
        local last_run_iso
        last_run_iso=$(now_iso)

        local remove_job=false
        if [[ -n "${max_runs}" && "${max_runs}" =~ ^[0-9]+$ && "${run_count}" -ge "${max_runs}" ]]; then
            remove_job=true
        fi

        if [[ "${remove_job}" == true ]]; then
            ids_to_remove+=("${id}")
        else
            local new_next_run="null"
            if [[ -n "${cron}" ]]; then
                case "${cron}" in
                    "0 9 * * *") new_next_run="$(next_daily_run)" ;;
                    "0 9 * * 0,6") new_next_run="$(next_weekend_run)" ;;
                    *) new_next_run="null" ;;
                esac
            else
                new_next_run="$(next_repeat_run "${now}" "${DEFAULT_REPEAT_INTERVAL_MINUTES}")"
            fi
            update_job_in_store "${id}" "$(printf '{"last_run":%s,"run_count":%d,"next_run":%s}' "$(json_escape "${last_run_iso}")" "${run_count}" "$(json_escape "${new_next_run}")")"
        fi

        ran=$((ran + 1))
    done

    for id in "${ids_to_remove[@]}"; do
        remove_job_from_store "${id}"
        echo "[scheduler] job ${id} removed (max runs reached)"
    done

    if (( ran == 0 )); then
        echo "[scheduler] no pending jobs"
    else
        echo "[scheduler] ${ran} job(s) executed"
    fi
}

cmd_install() {
    local os_name
    os_name=$(uname -s)
    local binary
    binary=$(command -v cockpit || echo "cockpit")

    if [[ "${os_name}" == "Linux" ]]; then
        local user_dir="${HOME}/.config/systemd/user"
        mkdir -p "${user_dir}"

        cat > "${user_dir}/cockpit-scheduler.service" <<EOF
[Unit]
Description=Cockpit Scheduler Runner

[Service]
Type=oneshot
ExecStart=${binary} scheduler run
EOF

        cat > "${user_dir}/cockpit-scheduler.timer" <<EOF
[Unit]
Description=Cockpit Scheduler Timer

[Timer]
OnBootSec=1min
OnUnitActiveSec=1m

[Install]
WantedBy=timers.target
EOF

        echo "[+] systemd user timer installed at ${user_dir}/cockpit-scheduler.timer"
        echo "    Activate with: systemctl --user daemon-reload && systemctl --user enable --now cockpit-scheduler.timer"

    elif [[ "${os_name}" == "Darwin" ]]; then
        local launch_dir="${HOME}/Library/LaunchAgents"
        mkdir -p "${launch_dir}"
        local plist="${launch_dir}/dev.aicockpit.scheduler.plist"

        cat > "${plist}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.aicockpit.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>${binary}</string>
        <string>scheduler</string>
        <string>run</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
EOF

        echo "[+] launchd plist installed at ${plist}"
        echo "    Activate with: launchctl load ${plist}"
    else
        echo "Error: unsupported OS '${os_name}'. Install cron or systemd manually." >&2
        exit 1
    fi
}

cmd_status() {
    local jobs
    jobs=$(read_jobs)
    local count
    count=$(echo "${jobs}" | "${JSON_TOOL}" -c "import json,sys; print(len(json.load(sys.stdin)))")
    local now
    now=$(now_epoch)
    local due=0

    for ((i = 0; i < count; i++)); do
        local job
        job=$(echo "${jobs}" | "${JSON_TOOL}" -c "import json,sys; print(json.dumps(json.load(sys.stdin)[int(sys.argv[1])]))" "${i}")
        local cron next_run
        cron=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('cron') or '')")
        next_run=$(echo "${job}" | "${JSON_TOOL}" -c "import json,sys; print(json.load(sys.stdin).get('next_run') or '')")
        if [[ -n "${cron}" ]]; then
            if cron_match_now "${cron}"; then
                due=$((due + 1))
            fi
        elif [[ -n "${next_run}" ]]; then
            local epoch
            epoch=$(iso_to_epoch "${next_run}")
            if (( epoch > 0 && epoch <= now )); then
                due=$((due + 1))
            fi
        fi
    done

    echo "Scheduler directory: ${SCHEDULER_DIR}"
    echo "Jobs file:           ${JOBS_FILE}"
    echo "Total jobs:          ${count}"
    echo "Due now:             ${due}"
    echo "JSON tool:           ${JSON_TOOL}"
}

main() {
    local subcommand="${1:-}"
    [[ $# -gt 0 ]] && shift

    case "${subcommand}" in
        add) cmd_add "$@" ;;
        list) cmd_list ;;
        remove) cmd_remove "$@" ;;
        run) cmd_run ;;
        install) cmd_install "$@" ;;
        status) cmd_status ;;
        --help|-h|help) usage ;;
        *)
            echo "Error: unknown subcommand '${subcommand}'" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"

