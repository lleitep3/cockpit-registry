#!/bin/bash
# Valida estrutura mínima do cockpit-mini-apps
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

required=(
    "boilerplate/with-db/backend"
    "boilerplate/with-db/frontend"
    "boilerplate/without-db/backend"
    "boilerplate/without-db/frontend"
    "bin/mini-app"
    "skills/mini-app-builder"
)

for path in "${required[@]}"; do
    if [[ ! -e "${PACKAGE_DIR}/${path}" ]]; then
        echo "ERRO: caminho obrigatório ausente: ${path}"
        exit 1
    fi
done

echo "OK: cockpit-mini-apps válido"
