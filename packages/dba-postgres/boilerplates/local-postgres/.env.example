# Configuration only; generated passwords live in .secrets/ (never commit them).
# lab-init generates an isolated project name. Adjust ports for simultaneous labs.
COMPOSE_PROJECT_NAME=dba-lab
POSTGRES_IMAGE=postgres:17.11-alpine
POSTGRES_DB=lab
POSTGRES_USER=lab_admin
POSTGRES_PORT=55432
PGADMIN_IMAGE=dpage/pgadmin4:9.18
PGADMIN_EMAIL=admin@example.com
PGADMIN_PORT=55080
