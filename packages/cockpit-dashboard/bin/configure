#!/bin/bash
# cockpit-dashboard: configuration script
#
# Sets default ports for the dashboard mini-app.

set -euo pipefail

CONFIG_DIR="${HOME}/.cockpit/packages/cockpit-dashboard"
CONFIG_FILE="${CONFIG_DIR}/config.json"

FRONTEND_PORT="${FRONTEND_PORT:-3000}"
BACKEND_PORT="${BACKEND_PORT:-8000}"

while [[ $# -gt 0 ]]; do
    case "${1}" in
        --frontend-port) FRONTEND_PORT="${2:-}"; shift 2 ;;
        --backend-port) BACKEND_PORT="${2:-}"; shift 2 ;;
        -h|--help)
            echo "Usage: cockpit dashboard configure [--frontend-port <N>] [--backend-port <N>]"
            exit 0
            ;;
        *) echo "Unknown option: ${1}" >&2; exit 1 ;;
    esac
done

mkdir -p "${CONFIG_DIR}"

cat > "${CONFIG_FILE}" <<JSON
{
  "frontend_port": ${FRONTEND_PORT},
  "backend_port": ${BACKEND_PORT}
}
JSON

echo "Configuration saved to ${CONFIG_FILE}"
echo "  frontend_port: ${FRONTEND_PORT}"
echo "  backend_port: ${BACKEND_PORT}"
