#!/usr/bin/env bash
set -euo pipefail

# Always use the token stored in the AICockpit vault; ignore any GH_TOKEN
# environment variable that may have been inherited from the parent shell.
unset GH_TOKEN

readonly NAMESPACE="github-tools"
readonly TOKEN_KEY="token"

usage() {
    cat <<'EOF'
Usage: cockpit github [--user USER] <command> [options]

GitHub CLI wrapper with vault-backed authentication and multi-profile support.

Global flags:
  --user USER     Use the GitHub profile registered for USER (default: configured default)

Commands:
  configure [--user USER] [--token TOKEN] [--name NAME] [--email EMAIL] [--default]
            [--default-owner OWNER] [--default-repo REPO]
  configure --list
  configure --remove --user USER
  run <gh args...>
  git <git args...>
  actions list [--repo OWNER/REPO] [--limit N]
  actions watch <run-id> [--repo OWNER/REPO]
  actions logs <run-id> [--repo OWNER/REPO]
  commits <branch> [--repo OWNER/REPO] [--limit N]
  pr comment <pr> --body "..." [--repo OWNER/REPO]
  pr approve <pr> [--repo OWNER/REPO]
  pr resolve <pr> [--repo OWNER/REPO]

If --repo is omitted, the package falls back to the configured default
(owner/repo stored during configure) or detects the repository from the
current Git directory.
EOF
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fail() {
    echo "Error: $1" >&2
    exit 1
}

get_default_user() {
    cockpit vault get "default-user" --namespace "$NAMESPACE" 2>/dev/null || true
}

get_user() {
    local user="${SELECTED_USER:-}"
    if [[ -z "$user" ]]; then
        user=$(get_default_user)
    fi
    if [[ -z "$user" ]]; then
        user="default"
    fi
    echo "$user"
}

get_token_for_user() {
    local user="$1"
    if [[ "$user" == "default" ]]; then
        cockpit vault get "$TOKEN_KEY" --namespace "$NAMESPACE" 2>/dev/null
        return $?
    fi
    cockpit vault get "token-${user}" --namespace "$NAMESPACE" 2>/dev/null
    return $?
}

get_token() {
    local user token
    user=$(get_user)
    token=$(get_token_for_user "$user") || fail "no token configured for user '${user}'; run 'cockpit github configure --user ${user} --token <TOKEN>'"
    GH_TOKEN="$token"
}

profile_list() {
    cockpit vault get "profile-list" --namespace "$NAMESPACE" 2>/dev/null || true
}

add_to_profile_list() {
    local user="$1"
    local list
    list=$(profile_list)
    if [[ -z "$list" ]]; then
        list="$user"
    elif [[ ",${list}," != *",${user},"* ]]; then
        list="${list},${user}"
    fi
    cockpit vault set "profile-list" --namespace "$NAMESPACE" --value "$list"
}

remove_from_profile_list() {
    local user="$1"
    local list
    list=$(profile_list)
    if [[ -z "$list" ]]; then
        return 0
    fi
    list=$(echo "$list" | tr ',' '\n' | grep -Fxv "$user" | paste -sd ',' -)
    if [[ -z "$list" ]]; then
        cockpit vault remove "profile-list" --namespace "$NAMESPACE" 2>/dev/null || true
    else
        cockpit vault set "profile-list" --namespace "$NAMESPACE" --value "$list"
    fi
}

require_gh() {
    local min_version="2.50.0"

    if ! command -v gh >/dev/null 2>&1; then
        fail "gh (GitHub CLI) is not installed. Install it from https://cli.github.com (required >= ${min_version})"
    fi

    local current_version
    current_version=$(gh --version | awk 'NR==1 {print $3}')

    if [[ -z "$current_version" ]]; then
        fail "could not determine gh version (required >= ${min_version})"
    fi

    local lowest
    lowest=$(printf '%s\n%s\n' "$min_version" "$current_version" | sort -V | head -n1)
    if [[ "$lowest" != "$min_version" ]]; then
        fail "gh version ${current_version} is too old (required >= ${min_version})"
    fi
}

validate_token() {
    local token="$1"
    if ! GH_TOKEN="$token" gh api user >/dev/null 2>&1; then
        fail "github token failed authentication against GitHub"
    fi
}

fetch_profile_info() {
    local token="$1"
    local name_override="${2:-}"
    local email_override="${3:-}"
    local login name email
    login=$(GH_TOKEN="$token" gh api user --jq '.login')

    if [[ -n "$name_override" ]]; then
        name="$name_override"
    else
        name="$login"
    fi

    if [[ -n "$email_override" ]]; then
        email="$email_override"
    else
        email="${login}@users.noreply.github.com"
    fi

    echo "${login}|${name}|${email}"
}

export_user_env() {
    local user login name email
    user=$(get_user)
    login=$(cockpit vault get "profile-${user}-login" --namespace "$NAMESPACE" 2>/dev/null || true)
    name=$(cockpit vault get "profile-${user}-name" --namespace "$NAMESPACE" 2>/dev/null || true)
    email=$(cockpit vault get "profile-${user}-email" --namespace "$NAMESPACE" 2>/dev/null || true)

    if [[ -z "$login" ]]; then
        login="$user"
    fi
    if [[ -z "$name" || "$name" == "null" ]]; then
        name="$login"
    fi
    if [[ -z "$email" || "$email" == "null" ]]; then
        email="${login}@users.noreply.github.com"
    fi

    export GIT_AUTHOR_NAME="$name"
    export GIT_COMMITTER_NAME="$name"
    export GIT_AUTHOR_EMAIL="$email"
    export GIT_COMMITTER_EMAIL="$email"
}

resolve_repo() {
    local repo_flag="${1:-}"
    if [[ -n "$repo_flag" ]]; then
        echo "$repo_flag"
        return
    fi

    local owner=""
    local name=""
    owner=$(cockpit vault get "default-owner" --namespace "$NAMESPACE" 2>/dev/null || true)
    name=$(cockpit vault get "default-repo" --namespace "$NAMESPACE" 2>/dev/null || true)

    if [[ -n "$owner" && -n "$name" ]]; then
        echo "$owner/$name"
        return
    fi

    get_token
    GH_TOKEN="$GH_TOKEN" gh repo view --json owner,name \
        --jq '"\(.owner.login)/\(.name)"' 2>/dev/null || fail "could not detect repository; set defaults with 'cockpit github configure' or pass --repo OWNER/REPO"
}

# ---------------------------------------------------------------------------
# configure
# ---------------------------------------------------------------------------

cmd_configure() {
    local user=""
    local token=""
    local name_override=""
    local email_override=""
    local default_owner=""
    local default_repo=""
    local make_default="false"
    local list_profiles="false"
    local remove_user="false"

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                user="${2:-}"
                shift 2
                ;;
            --token)
                token="${2:-}"
                shift 2
                ;;
            --default-owner)
                default_owner="${2:-}"
                shift 2
                ;;
            --default-repo)
                default_repo="${2:-}"
                shift 2
                ;;
            --name)
                name_override="${2:-}"
                shift 2
                ;;
            --email)
                email_override="${2:-}"
                shift 2
                ;;
            --default)
                make_default="true"
                shift
                ;;
            --list)
                list_profiles="true"
                shift
                ;;
            --remove)
                remove_user="true"
                shift
                ;;
            *)
                fail "unknown configure flag: $1"
                ;;
        esac
    done

    if [[ "$list_profiles" == "true" ]]; then
        local default
        default=$(get_default_user)
        echo "Default user: ${default:-<none>}"
        echo "Profiles:"
        local list has_default="false"
        list=$(profile_list)
        if cockpit vault get "$TOKEN_KEY" --namespace "$NAMESPACE" >/dev/null 2>&1; then
            has_default="true"
            if [[ -z "$list" || -z "$default" || "$default" == "default" ]]; then
                echo "  default"
            fi
        fi
        if [[ -n "$list" ]]; then
            IFS=',' read -ra users <<< "$list"
            for u in "${users[@]}"; do
                if [[ "$u" == "$default" ]]; then
                    echo "  $u (default)"
                else
                    echo "  $u"
                fi
            done
        elif [[ "$has_default" != "true" ]]; then
            echo "  <none>"
        fi
        return 0
    fi

    if [[ "$remove_user" == "true" ]]; then
        [[ -n "$user" ]] || fail "--user is required with --remove"
        cockpit vault remove "token-${user}" --namespace "$NAMESPACE" 2>/dev/null || true
        cockpit vault remove "profile-${user}-login" --namespace "$NAMESPACE" 2>/dev/null || true
        cockpit vault remove "profile-${user}-name" --namespace "$NAMESPACE" 2>/dev/null || true
        cockpit vault remove "profile-${user}-email" --namespace "$NAMESPACE" 2>/dev/null || true
        remove_from_profile_list "$user"
        local default
        default=$(get_default_user)
        if [[ "$default" == "$user" ]]; then
            cockpit vault remove "default-user" --namespace "$NAMESPACE" 2>/dev/null || true
        fi
        echo "Profile '${user}' removed."
        return 0
    fi

    [[ -n "$user" ]] || user="default"

    if [[ -z "$token" ]]; then
        read -rsp "GitHub token for user '${user}': " token || true
        echo
    fi

    if [[ -z "$token" ]]; then
        fail "github token is required"
    fi

    require_gh
    validate_token "$token"

    local info login name email rest
    info=$(fetch_profile_info "$token" "$name_override" "$email_override")
    login="${info%%|*}"
    rest="${info#*|}"
    name="${rest%%|*}"
    email="${rest##*|}"

    if [[ "$user" == "default" ]]; then
        cockpit vault set "$TOKEN_KEY" --namespace "$NAMESPACE" --value "$token"
    else
        cockpit vault set "token-${user}" --namespace "$NAMESPACE" --value "$token"
        add_to_profile_list "$user"
    fi

    cockpit vault set "profile-${user}-login" --namespace "$NAMESPACE" --value "$login"
    cockpit vault set "profile-${user}-name" --namespace "$NAMESPACE" --value "$name"
    cockpit vault set "profile-${user}-email" --namespace "$NAMESPACE" --value "$email"

    if [[ "$make_default" == "true" ]]; then
        cockpit vault set "default-user" --namespace "$NAMESPACE" --value "$user"
    fi

    if [[ -n "$default_owner" ]]; then
        cockpit vault set "default-owner" --namespace "$NAMESPACE" --value "$default_owner"
    fi
    if [[ -n "$default_repo" ]]; then
        cockpit vault set "default-repo" --namespace "$NAMESPACE" --value "$default_repo"
    fi

    echo "GitHub profile '${user}' configured successfully (${login})."
}

# ---------------------------------------------------------------------------
# run / git
# ---------------------------------------------------------------------------

cmd_run() {
    shift
    require_gh
    get_token
    GH_TOKEN="$GH_TOKEN" exec gh "$@"
}

cmd_git() {
    shift
    require_gh
    export_user_env
    get_token
    GH_TOKEN="$GH_TOKEN" exec git "$@"
}

# ---------------------------------------------------------------------------
# actions
# ---------------------------------------------------------------------------

cmd_actions_list() {
    local repo=""
    local limit="10"

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            --limit)
                limit="${2:-}"
                shift 2
                ;;
            *)
                fail "unknown actions list flag: $1"
                ;;
        esac
    done

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh run list \
        --repo "$repo" \
        --limit "$limit" \
        --json databaseId,name,status,conclusion,createdAt,headBranch
}

cmd_actions_watch() {
    local repo=""
    local run_id=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown actions watch flag: $1"
                ;;
            *)
                if [[ -n "$run_id" ]]; then
                    fail "unexpected argument: $1"
                fi
                run_id="$1"
                shift
                ;;
        esac
    done

    [[ -n "$run_id" ]] || fail "run-id is required"

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh run watch "$run_id" --repo "$repo"
}

cmd_actions_logs() {
    local repo=""
    local run_id=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown actions logs flag: $1"
                ;;
            *)
                if [[ -n "$run_id" ]]; then
                    fail "unexpected argument: $1"
                fi
                run_id="$1"
                shift
                ;;
        esac
    done

    [[ -n "$run_id" ]] || fail "run-id is required"

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh run view "$run_id" --repo "$repo" --log
}

cmd_actions() {
    case "${2:-}" in
        list) cmd_actions_list "${@:2}" ;;
        watch) cmd_actions_watch "${@:2}" ;;
        logs) cmd_actions_logs "${@:2}" ;;
        *) fail "unknown actions subcommand: ${2:-}; expected list, watch or logs" ;;
    esac
}

# ---------------------------------------------------------------------------
# commits
# ---------------------------------------------------------------------------

cmd_commits() {
    local repo=""
    local limit="10"
    local branch=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            --limit)
                limit="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown commits flag: $1"
                ;;
            *)
                if [[ -n "$branch" ]]; then
                    fail "unexpected argument: $1"
                fi
                branch="$1"
                shift
                ;;
        esac
    done

    [[ -n "$branch" ]] || fail "branch name is required"

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh api "repos/${repo}/commits?sha=${branch}&per_page=${limit}" \
        --jq '.[] | "\(.sha[:7])  \(.commit.author.name)  \(.commit.author.date)  \(.commit.message | split("\n")[0])"'
}

# ---------------------------------------------------------------------------
# pr
# ---------------------------------------------------------------------------

cmd_pr_comment() {
    local repo=""
    local body=""
    local pr=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            --body)
                body="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown pr comment flag: $1"
                ;;
            *)
                if [[ -n "$pr" ]]; then
                    fail "unexpected argument: $1"
                fi
                pr="$1"
                shift
                ;;
        esac
    done

    [[ -n "$pr" ]] || fail "pull request number is required"
    [[ -n "$body" ]] || fail "--body is required"

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh pr comment "$pr" --repo "$repo" --body "$body"
}

cmd_pr_approve() {
    local repo=""
    local pr=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown pr approve flag: $1"
                ;;
            *)
                if [[ -n "$pr" ]]; then
                    fail "unexpected argument: $1"
                fi
                pr="$1"
                shift
                ;;
        esac
    done

    [[ -n "$pr" ]] || fail "pull request number is required"

    require_gh
    repo=$(resolve_repo "$repo")
    get_token
    GH_TOKEN="$GH_TOKEN" gh pr review "$pr" --repo "$repo" --approve
}

cmd_pr_resolve() {
    local repo=""
    local pr=""

    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                repo="${2:-}"
                shift 2
                ;;
            -*)
                fail "unknown pr resolve flag: $1"
                ;;
            *)
                if [[ -n "$pr" ]]; then
                    fail "unexpected argument: $1"
                fi
                pr="$1"
                shift
                ;;
        esac
    done

    [[ -n "$pr" ]] || fail "pull request number is required"
    [[ "$pr" =~ ^[0-9]+$ ]] || fail "pull request must be a number"

    require_gh
    repo=$(resolve_repo "$repo")

    local owner=""
    local name=""
    owner="${repo%%/*}"
    name="${repo##*/}"

    local query
    query='query($owner: String!, $repo: String!, $pr: Int!) {
      repository(owner: $owner, name: $repo) {
        pullRequest(number: $pr) {
          reviewThreads(first: 100) {
            nodes { id isResolved }
          }
        }
      }
    }'

    local ids=""
    ids=$(get_token
    GH_TOKEN="$GH_TOKEN" gh api graphql \
        --raw-field "query=${query}" \
        --raw-field "owner=${owner}" \
        --raw-field "repo=${name}" \
        --raw-field "pr=${pr}" \
        --jq '.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false) | .id' 2>/dev/null || true)

    if [[ -z "$ids" ]]; then
        echo "No unresolved review threads found."
        return
    fi

    local mutation
    mutation='mutation($id: ID!) {
      resolveReviewThread(input: {threadId: $id}) {
        thread { id isResolved }
      }
    }'

    local resolved=0
    while IFS= read -r thread_id; do
        [[ -n "$thread_id" ]] || continue
        get_token
    GH_TOKEN="$GH_TOKEN" gh api graphql \
            --raw-field "query=${mutation}" \
            --raw-field "id=${thread_id}"
        echo "Resolved thread: ${thread_id}"
        resolved=$((resolved + 1))
    done <<< "$ids"

    echo "Resolved ${resolved} review thread(s)."
}

cmd_pr() {
    case "${2:-}" in
        comment) cmd_pr_comment "${@:2}" ;;
        approve) cmd_pr_approve "${@:2}" ;;
        resolve) cmd_pr_resolve "${@:2}" ;;
        *) fail "unknown pr subcommand: ${2:-}; expected comment, approve or resolve" ;;
    esac
}

# ---------------------------------------------------------------------------
# Main dispatcher
# ---------------------------------------------------------------------------

main() {
    [[ $# -eq 0 ]] && { usage; exit 1; }

    SELECTED_USER=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                SELECTED_USER="${2:-}"
                shift 2
                ;;
            help|--help|-h)
                usage
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    export SELECTED_USER

    [[ $# -eq 0 ]] && { usage; exit 1; }

    case "$1" in
        configure) cmd_configure "$@" ;;
        run) cmd_run "$@" ;;
        git) cmd_git "$@" ;;
        actions) cmd_actions "$@" ;;
        commits) cmd_commits "$@" ;;
        pr) cmd_pr "$@" ;;
        *) fail "unknown command: $1" ;;
    esac
}

main "$@"
